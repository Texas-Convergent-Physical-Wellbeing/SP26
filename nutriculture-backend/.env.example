# ─── NutriCulture Backend — Environment Variables ────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─── Supabase ─────────────────────────────────────────────────────────────────

# Your Supabase project URL.
# Found at: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Supabase service-role key (bypasses RLS — KEEP SECRET, server-side only).
# Found at: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.<your-service-key>

# ─── Anthropic ────────────────────────────────────────────────────────────────

# Your Anthropic API key for Claude access.
# Found at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-<your-anthropic-key>

# ─── Application ──────────────────────────────────────────────────────────────

# Deployment environment: "dev" enables /docs and /redoc; "prod" disables them.
ENVIRONMENT=dev

# Random secret key used for signing internal session material.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

# Comma-separated list of allowed CORS origins.
# React Native native builds: CORS is not enforced by iOS/Android — this value
# is only relevant for Expo Go web preview (http://localhost:19006) or a web
# admin panel. "*" is safe in development; lock it down for production web.
CORS_ORIGINS=*

# Max seconds to wait for a Claude response before returning HTTP 504.
# Claude meal-plan generation typically takes 15–30 s on claude-sonnet-4-6.
# Increase if you observe timeouts on large/complex profiles.
LLM_TIMEOUT_SECONDS=60
